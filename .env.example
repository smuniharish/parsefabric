# Configuration for the optional language-model examples and live tests.
# ParseFabric itself reads no environment variables. Copy this file to .env
# (ignored by git) or export the variables in your shell. Never commit keys.

# OpenAI-compatible endpoint used by examples/llm_summary_openai_compatible.py,
# examples/semantic_llm.py, benchmarks/review_evaluation.py and `pytest -m live`.
PARSEFABRIC_LLM_API_KEY=
# Optional: base URL ending in /v1; defaults to the OpenAI API.
PARSEFABRIC_LLM_BASE_URL=
# Optional: model name; defaults to gpt-5-mini. For examples/llm_summary.py,
# an init_chat_model identifier such as openai:gpt-5-mini.
PARSEFABRIC_LLM_MODEL=
